# --- App ---
APP_NAME=AI-Powered Security Triage Assistant
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
POSTGRES_USER=triage_user
POSTGRES_PASSWORD=triage_password
POSTGRES_DB=triage_assistant
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://triage_user:triage_password@db:5432/triage_assistant

# --- LLM provider ---
# "ollama" = free local model via Ollama (no API key needed, default below).
# "openai" = OpenAI's hosted API (requires OPENAI_API_KEY + credits).
LLM_PROVIDER=ollama

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# --- Ollama (used when LLM_PROVIDER=ollama) ---
# Install Ollama on your machine (https://ollama.com) and make sure it's
# running, then pull the model below (or change OLLAMA_MODEL to one you have):
#   ollama pull llama3.2
# NOTE: avoid "llama3.2-vision" unless your Ollama app is fully up to date --
# it uses the "mllama" architecture, which crashes on older Ollama versions
# with "unknown model architecture: 'mllama'". This app only analyzes text
# (emails/logs), so a plain text model like llama3.2 works great and avoids
# that issue entirely.
# host.docker.internal lets the backend container reach your host machine.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.2:3b

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=20

# --- Vector store (RAG bonus) ---
CHROMA_PERSIST_DIR=/app/data/chroma

# --- Threat Intelligence (optional) ---
# Used for live IOC enrichment lookups (VirusTotal, Shodan, AbuseIPDB). Leave
# a key blank to keep that source's card in "not configured" mode in the
# Analyzer's Threat Intelligence panel.
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
# Hours a successful lookup result is reused before re-querying the same
# indicator (saves API quota across analyses that share IOCs).
THREAT_INTEL_CACHE_TTL_HOURS=12

# --- Notifications (optional) ---
# Slack incoming webhook URL. When set, a short message is posted whenever
# an analysis is classified Critical. Leave blank to disable.
SLACK_WEBHOOK_URL=

# --- IntelOwl Threat Intelligence integration ---
INTELOWL_URL=http://host.docker.internal
INTELOWL_API_TOKEN=
INTELOWL_TIMEOUT=120
INTELOWL_VERIFY_SSL=false
INTELOWL_CACHE_TTL_SECONDS=3600
INTELOWL_DEFAULT_PLAYBOOK=
